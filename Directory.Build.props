<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>

    <!--
      Single source of the product version. The installer reads it, the app reports it
      to the update server, and the release workflow tags with it.
    -->
    <Version>0.1.0</Version>
    <Company>Elerdir</Company>
    <Product>Luma</Product>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
  </PropertyGroup>

  <!--
    Scoped suppression: Tmds.DBus.Protocol (GHSA-xrw6-gwf8-vvr9) arrives only as a
    transitive dependency of Avalonia's Linux backend. The fix is a major-version
    jump Avalonia 11.3 does not depend on, and the code path is unused on Windows.
    Revisit when Avalonia bumps the dependency. Suppressing this one advisory keeps
    real future NU1903 warnings visible.
  -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-xrw6-gwf8-vvr9" />
  </ItemGroup>
</Project>
