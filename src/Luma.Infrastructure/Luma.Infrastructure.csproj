<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\Luma.Application\Luma.Application.csproj" />
    <ProjectReference Include="..\Luma.Domain\Luma.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />

    <!--
      Kept in step with Luma.Presentation: both projects reference the native package,
      and leaving this one unconditional would drag the Windows binaries into a macOS
      publish through the project reference. See that file for why there is no macOS
      NuGet equivalent.
    -->
    <PackageReference Include="VideoLAN.LibVLC.Windows"
                      Condition="'$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('win'))" />
  </ItemGroup>
</Project>
