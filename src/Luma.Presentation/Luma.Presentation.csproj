<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Ship as Luma.exe rather than Luma.Presentation.exe; the project name is an
         internal layering detail and should not surface in Program Files. -->
    <AssemblyName>Luma</AssemblyName>
    <RootNamespace>Luma.Presentation</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- Icons are generated from tools/Luma.IconGen; luma-icon.svg is the design source. -->
    <ApplicationIcon>Assets\luma.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="LibVLCSharp.Avalonia" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" />
    <PackageReference Include="Avalonia.Diagnostics">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Luma.Application\Luma.Application.csproj" />
    <ProjectReference Include="..\Luma.Infrastructure\Luma.Infrastructure.csproj" />
    <ProjectReference Include="..\Luma.Domain\Luma.Domain.csproj" />
  </ItemGroup>
</Project>
