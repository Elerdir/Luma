<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Ship as Luma.exe rather than Luma.Presentation.exe; the project name is an
         internal layering detail and should not surface in Program Files. -->
    <AssemblyName>Luma</AssemblyName>
    <RootNamespace>Luma.Presentation</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- Icons are generated from tools/Luma.IconGen; luma-icon.svg is the design source. -->
    <ApplicationIcon>Assets\luma.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!--
    Strings.resx and Strings.<culture>.resx under Localization\ are picked up by the
    SDK's default EmbeddedResource glob; each culture becomes a satellite assembly.
    They are read through ResourceManager by name, so there is no generated designer
    class and translations build the same from the CLI as from an IDE.
  -->

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="LibVLCSharp.Avalonia" />

    <!--
      Native libvlc, Windows only. Restricted by RuntimeIdentifier so a macOS publish
      does not drag Windows DLLs along; with no RID (a plain build, or the tests) it
      still applies, which is what the dev flow and CI already assumed.

      There is deliberately no VideoLAN.LibVLC.Mac here: that package ships a single
      x64 libvlc.dylib and no plugin directory, so it can neither load on Apple silicon
      nor decode anything. The macOS bundle takes its libvlc from the official VLC
      release instead — see .github/workflows/release.yml. Linux likewise expects
      libvlc to be installed system-wide.
    -->
    <PackageReference Include="VideoLAN.LibVLC.Windows"
                      Condition="'$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('win'))" />
    <PackageReference Include="Avalonia.Diagnostics">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Luma.Application\Luma.Application.csproj" />
    <ProjectReference Include="..\Luma.Infrastructure\Luma.Infrastructure.csproj" />
    <ProjectReference Include="..\Luma.Domain\Luma.Domain.csproj" />
  </ItemGroup>
</Project>
