<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
        xmlns:vm="clr-namespace:Luma.Presentation.ViewModels"
        xmlns:loc="clr-namespace:Luma.Presentation.Localization"
        xmlns:conv="clr-namespace:Luma.Presentation.Converters"
        xmlns:md="clr-namespace:Luma.Domain.Media;assembly=Luma.Domain"
        xmlns:pl="clr-namespace:Luma.Domain.Playlists;assembly=Luma.Domain"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="600"
        x:Class="Luma.Presentation.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}" Icon="/Assets/luma.png"
        Width="960" Height="600"
        MinWidth="560" MinHeight="360"
        Background="#0E0F13"
        DragDrop.AllowDrop="True">

    <Window.KeyBindings>
        <KeyBinding Gesture="Space" Command="{Binding PlayPauseCommand}" />
        <KeyBinding Gesture="K" Command="{Binding PlayPauseCommand}" />
        <KeyBinding Gesture="Left" Command="{Binding SeekBackwardCommand}" />
        <KeyBinding Gesture="Right" Command="{Binding SeekForwardCommand}" />
        <KeyBinding Gesture="Shift+Left" Command="{Binding SeekBackwardLargeCommand}" />
        <KeyBinding Gesture="Shift+Right" Command="{Binding SeekForwardLargeCommand}" />
        <KeyBinding Gesture="Up" Command="{Binding VolumeUpCommand}" />
        <KeyBinding Gesture="Down" Command="{Binding VolumeDownCommand}" />
        <KeyBinding Gesture="M" Command="{Binding ToggleMuteCommand}" />
        <KeyBinding Gesture="S" Command="{Binding StopCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
        <KeyBinding Gesture="N" Command="{Binding NextCommand}" />
        <KeyBinding Gesture="P" Command="{Binding PreviousCommand}" />
        <KeyBinding Gesture="R" Command="{Binding CycleRepeatCommand}" />
        <KeyBinding Gesture="L" Command="{Binding TogglePlaylistCommand}" />
    </Window.KeyBindings>

    <Grid Name="RootGrid" RowDefinitions="*,Auto" ColumnDefinitions="*,Auto">

        <!--
          Video surface. The overlay lives *inside* VideoView: it hosts its content in a
          transparent floating window stacked above the native video surface, which is the
          only layer that receives pointer input there — a sibling control would be covered
          by the native child window and never see a click. Double-click toggles fullscreen.
        -->
        <Panel Grid.Row="0" Grid.Column="0" Name="VideoArea" Background="Black"
               DoubleTapped="OnVideoAreaDoubleTapped"
               PointerReleased="OnVideoPointerReleased">
            <vlc:VideoView Name="VideoView">
                <Panel Name="VideoOverlay" Background="Transparent"
                       DoubleTapped="OnVideoAreaDoubleTapped">

                    <!--
                      Right-click menu. It lives on the overlay rather than on VideoArea
                      because the overlay is the layer that actually receives pointer
                      input over the native video surface.

                      Submenu ticks compare against the same properties the rest of the
                      app uses, so there is no second copy of "what is selected".
                    -->
                    <Panel.ContextFlyout>
                        <MenuFlyout>
                            <MenuItem Header="{loc:Localize Menu.Open}"
                                      Command="{Binding OpenCommand}" InputGesture="Ctrl+O" />
                            <Separator />

                            <MenuItem Header="{loc:Localize Menu.PlayPause}"
                                      Command="{Binding PlayPauseCommand}" InputGesture="Space" />
                            <MenuItem Header="{loc:Localize Menu.Stop}"
                                      Command="{Binding StopCommand}" InputGesture="S" />
                            <MenuItem Header="{loc:Localize Menu.Previous}"
                                      Command="{Binding PreviousCommand}" InputGesture="P" />
                            <MenuItem Header="{loc:Localize Menu.Next}"
                                      Command="{Binding NextCommand}" InputGesture="N" />

                            <Separator />

                            <MenuItem Header="{loc:Localize Menu.AudioTrack}"
                                      IsEnabled="{Binding HasMedia}"
                                      ItemsSource="{Binding AudioTracks}">
                                <MenuItem.ItemContainerTheme>
                                    <ControlTheme TargetType="MenuItem"
                                                  BasedOn="{StaticResource {x:Type MenuItem}}"
                                                  x:DataType="md:MediaTrack">
                                        <Setter Property="Header" Value="{Binding Name}" />
                                        <Setter Property="ToggleType" Value="Radio" />
                                        <Setter Property="Command"
                                                Value="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectAudioCommand}" />
                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                        <Setter Property="IsChecked">
                                            <Setter.Value>
                                                <MultiBinding Converter="{x:Static conv:EqualityConverter.Instance}">
                                                    <Binding />
                                                    <Binding Path="$parent[Window].((vm:MainViewModel)DataContext).SelectedAudioTrack" />
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </ControlTheme>
                                </MenuItem.ItemContainerTheme>
                            </MenuItem>

                            <MenuItem Header="{loc:Localize Menu.Subtitles}"
                                      IsEnabled="{Binding HasMedia}"
                                      ItemsSource="{Binding SubtitleOptions}">
                                <MenuItem.ItemContainerTheme>
                                    <ControlTheme TargetType="MenuItem"
                                                  BasedOn="{StaticResource {x:Type MenuItem}}"
                                                  x:DataType="md:MediaTrack">
                                        <Setter Property="Header" Value="{Binding Name}" />
                                        <Setter Property="ToggleType" Value="Radio" />
                                        <Setter Property="Command"
                                                Value="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectSubtitleCommand}" />
                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                        <Setter Property="IsChecked">
                                            <Setter.Value>
                                                <MultiBinding Converter="{x:Static conv:EqualityConverter.Instance}">
                                                    <Binding />
                                                    <Binding Path="$parent[Window].((vm:MainViewModel)DataContext).SelectedSubtitle" />
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </ControlTheme>
                                </MenuItem.ItemContainerTheme>
                            </MenuItem>

                            <MenuItem Header="{loc:Localize Menu.LoadSubtitle}"
                                      Command="{Binding LoadSubtitleCommand}" />

                            <MenuItem Header="{loc:Localize Menu.Speed}"
                                      ItemsSource="{Binding RateOptions}">
                                <MenuItem.ItemContainerTheme>
                                    <ControlTheme TargetType="MenuItem"
                                                  BasedOn="{StaticResource {x:Type MenuItem}}"
                                                  x:DataType="x:Double">
                                        <Setter Property="Header" Value="{Binding StringFormat='{}{0}x'}" />
                                        <Setter Property="ToggleType" Value="Radio" />
                                        <Setter Property="Command"
                                                Value="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectRateCommand}" />
                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                        <Setter Property="IsChecked">
                                            <Setter.Value>
                                                <MultiBinding Converter="{x:Static conv:EqualityConverter.Instance}">
                                                    <Binding />
                                                    <Binding Path="$parent[Window].((vm:MainViewModel)DataContext).SelectedRate" />
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </ControlTheme>
                                </MenuItem.ItemContainerTheme>
                            </MenuItem>

                            <MenuItem Header="{loc:Localize Menu.Repeat}">
                                <MenuItem Header="{loc:Localize Menu.RepeatOff}" ToggleType="Radio"
                                          Command="{Binding SetRepeatCommand}"
                                          CommandParameter="{x:Static pl:RepeatMode.None}">
                                    <MenuItem.IsChecked>
                                        <MultiBinding Converter="{x:Static conv:EqualityConverter.Instance}">
                                            <Binding Path="Repeat" />
                                            <Binding Source="{x:Static pl:RepeatMode.None}" />
                                        </MultiBinding>
                                    </MenuItem.IsChecked>
                                </MenuItem>
                                <MenuItem Header="{loc:Localize Menu.RepeatOne}" ToggleType="Radio"
                                          Command="{Binding SetRepeatCommand}"
                                          CommandParameter="{x:Static pl:RepeatMode.One}">
                                    <MenuItem.IsChecked>
                                        <MultiBinding Converter="{x:Static conv:EqualityConverter.Instance}">
                                            <Binding Path="Repeat" />
                                            <Binding Source="{x:Static pl:RepeatMode.One}" />
                                        </MultiBinding>
                                    </MenuItem.IsChecked>
                                </MenuItem>
                                <MenuItem Header="{loc:Localize Menu.RepeatAll}" ToggleType="Radio"
                                          Command="{Binding SetRepeatCommand}"
                                          CommandParameter="{x:Static pl:RepeatMode.All}">
                                    <MenuItem.IsChecked>
                                        <MultiBinding Converter="{x:Static conv:EqualityConverter.Instance}">
                                            <Binding Path="Repeat" />
                                            <Binding Source="{x:Static pl:RepeatMode.All}" />
                                        </MultiBinding>
                                    </MenuItem.IsChecked>
                                </MenuItem>
                            </MenuItem>

                            <Separator />

                            <MenuItem Header="{loc:Localize Menu.Playlist}" ToggleType="CheckBox"
                                      IsChecked="{Binding IsPlaylistVisible}"
                                      Command="{Binding TogglePlaylistCommand}" InputGesture="L" />
                            <MenuItem Header="{loc:Localize Menu.Fullscreen}"
                                      Click="OnFullscreenMenuClick" InputGesture="F" />

                            <MenuItem Header="{loc:Localize Menu.Language}"
                                      ItemsSource="{Binding Languages}">
                                <MenuItem.ItemContainerTheme>
                                    <ControlTheme TargetType="MenuItem"
                                                  BasedOn="{StaticResource {x:Type MenuItem}}"
                                                  x:DataType="loc:LanguageOption">
                                        <Setter Property="Header" Value="{Binding DisplayName}" />
                                        <Setter Property="ToggleType" Value="Radio" />
                                        <Setter Property="Command"
                                                Value="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectLanguageCommand}" />
                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                        <Setter Property="IsChecked">
                                            <Setter.Value>
                                                <MultiBinding Converter="{x:Static conv:EqualityConverter.Instance}">
                                                    <Binding />
                                                    <Binding Path="$parent[Window].((vm:MainViewModel)DataContext).SelectedLanguage" />
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </ControlTheme>
                                </MenuItem.ItemContainerTheme>
                            </MenuItem>
                        </MenuFlyout>
                    </Panel.ContextFlyout>

                    <StackPanel IsVisible="{Binding !HasMedia}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Spacing="14" Orientation="Vertical">
                        <!-- Luma mark: aperture ring + luma-gradient play triangle -->
                        <Panel Width="92" Height="92" HorizontalAlignment="Center">
                            <Ellipse Width="92" Height="92"
                                     Stroke="#2A2D37" StrokeThickness="6" />
                            <Path HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M 0,0 L 26,15 L 0,30 Z">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Offset="0" Color="#FF7A45" />
                                        <GradientStop Offset="1" Color="#3FA9F5" />
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>
                        </Panel>
                        <TextBlock Text="Luma" FontSize="30" FontWeight="Light"
                                   Foreground="#E8EAED" HorizontalAlignment="Center" />
                        <TextBlock Text="{loc:Localize App.OpenPrompt}"
                                   Foreground="#7A7F8A" FontSize="13" HorizontalAlignment="Center" />
                    </StackPanel>
                </Panel>
            </vlc:VideoView>
        </Panel>

        <!-- Playlist panel -->
        <Border Grid.Row="0" Grid.Column="1" Name="PlaylistPanel"
                IsVisible="{Binding IsPlaylistVisible}"
                Width="280" Background="#12141A"
                BorderBrush="#22252E" BorderThickness="1,0,0,0">
            <Grid RowDefinitions="Auto,*,Auto">

                <TextBlock Grid.Row="0" Text="{loc:Localize Playlist.Title}" Foreground="#C7CBD2"
                           FontSize="13" Margin="12,10,12,8" />

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Playlist}"
                         SelectedItem="{Binding SelectedPlaylistItem, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         DoubleTapped="OnPlaylistDoubleTapped">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlaylistItemViewModel">
                            <Grid ColumnDefinitions="Auto,*" ToolTip.Tip="{Binding Location}">
                                <!-- Marks the entry the player is on right now -->
                                <TextBlock Grid.Column="0" Text="▸" Width="14"
                                           Foreground="#FF7A45"
                                           IsVisible="{Binding IsCurrent}" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6"
                            Margin="12,8,12,10">
                    <Button Content="{loc:Localize Button.Play}" Command="{Binding PlaySelectedCommand}" />
                    <Button Content="{loc:Localize Button.Remove}" Command="{Binding RemoveSelectedCommand}" />
                    <Button Content="{loc:Localize Button.Clear}" Command="{Binding ClearPlaylistCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Transport bar -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                Name="TransportBar" Background="#15171D" Padding="14,10">
            <StackPanel Spacing="8">

                <!-- Seek row -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding PositionText}"
                               Foreground="#9AA0AB" VerticalAlignment="Center" Width="60" />
                    <Slider Grid.Column="1" Minimum="0"
                            Maximum="{Binding DurationSeconds}"
                            Value="{Binding PositionSeconds, Mode=TwoWay}"
                            IsEnabled="{Binding CanSeek}"
                            VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding DurationText}"
                               Foreground="#9AA0AB" VerticalAlignment="Center"
                               Width="60" TextAlignment="Right" />
                </Grid>

                <!--
                  Controls row. A WrapPanel rather than a Grid: with fixed columns the
                  rightmost group (the volume) was simply pushed past the window edge
                  as soon as the window narrowed. Wrapping moves whole groups onto a
                  second line instead, so every control stays reachable at any width —
                  the bar grows taller rather than losing things.
                -->
                <WrapPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center" Margin="0,0,14,4">
                        <!-- Icon rather than a word: it sits among the transport glyphs,
                             and the recent list moved to the right-click menu. -->
                        <Button Content="📂" Command="{Binding OpenCommand}"
                                ToolTip.Tip="{loc:Localize Tooltip.Open}" />
                        <Button Content="⏮" Command="{Binding PreviousCommand}"
                                ToolTip.Tip="{loc:Localize Tooltip.Previous}" />
                        <Button Content="{Binding PlayPauseGlyph}"
                                Command="{Binding PlayPauseCommand}" Width="52" />
                        <Button Content="⏭" Command="{Binding NextCommand}"
                                ToolTip.Tip="{loc:Localize Tooltip.Next}" />
                        <Button Content="■" Command="{Binding StopCommand}"
                                ToolTip.Tip="{loc:Localize Tooltip.Stop}" />
                    </StackPanel>

                    <!--
                      The file name is not repeated here: it is the window title.
                      Repeat, speed, audio track, subtitles and language have moved to
                      the right-click menu on the video — they are set once and then
                      left alone, so they do not earn permanent space next to the
                      controls people reach for constantly.
                    -->
                    <StackPanel Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center" Margin="0,0,14,4">
                        <Button Content="☰" Command="{Binding TogglePlaylistCommand}"
                                ToolTip.Tip="{loc:Localize Tooltip.Playlist}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center">
                        <Button Content="{Binding VolumeGlyph}"
                                Command="{Binding ToggleMuteCommand}"
                                Background="Transparent" BorderThickness="0"
                                Padding="4,2" VerticalAlignment="Center"
                                ToolTip.Tip="{loc:Localize Tooltip.Mute}" />
                        <!-- Allowed to shrink so the volume group is the last thing
                             that would ever need a line of its own. -->
                        <Slider Minimum="0" Maximum="100"
                                Value="{Binding Volume, Mode=TwoWay}"
                                MinWidth="90" Width="120" VerticalAlignment="Center" />
                    </StackPanel>
                </WrapPanel>

                <!-- Update banner. Only present once the server has offered something,
                     so a player with no update configured looks exactly as before. -->
                <Border IsVisible="{Binding IsUpdateAvailable}"
                        Background="#1B2430" BorderBrush="#2E4055" BorderThickness="1"
                        CornerRadius="4" Padding="10,7">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <TextBlock Grid.Column="0" Text="⬆" Foreground="#3FA9F5"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" Text="{Binding UpdateBannerText}"
                                   Foreground="#C7CBD2" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" Content="{loc:Localize Button.Install}"
                                Command="{Binding InstallUpdateCommand}"
                                Margin="8,0,6,0" />
                        <Button Grid.Column="3" Content="✕"
                                Command="{Binding DismissUpdateCommand}"
                                IsEnabled="{Binding !IsDownloadingUpdate}"
                                Background="Transparent" BorderThickness="0"
                                ToolTip.Tip="{loc:Localize Tooltip.DismissUpdate}" />
                    </Grid>
                </Border>

                <TextBlock Text="{Binding StatusText}" Foreground="#6C7280" FontSize="12" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
